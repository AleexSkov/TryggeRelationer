    .contact > p:last-child {
        margin-top: 30px;
        color: #718878;
    }

    @@media (max-width: 800px) {
        .hero {
            padding-top: 140px;
        }

        .hero-decoration {
            opacity: 0.5;
            right: -180px;
        }

        .about {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .about > p {
            margin-top: 0;
        }
    }

    @@media (max-width: 600px) {
        .nav-links {
            display: none;
        }

        .hero {
            padding-left: 6%;
            padding-right: 6%;
        }

        .about,
        .contact {
            padding-left: 6%;
            padding-right: 6%;
        }
    }
</style>